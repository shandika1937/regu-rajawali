    <!-- ===== SCRIPTS ===== -->
    <script src="data/members.js"></script>
    <script src="data/schedule.js"></script>
    <script src="firebase/firebase-config.js"></script>
    <script src="assets/js/three-bg.js"></script>
    <script src="assets/js/particles.js"></script>
    <script src="assets/js/main.js"></script>
    <script src="assets/js/chatbot.js"></script>
    <script src="assets/js/gallery.js"></script>
    <script src="assets/js/stats.js"></script>
    <script src="assets/js/admin.js"></script>

    <script>
        // ========== RENDER MEMBERS (with admin photo support) ==========
        function handlePhotoError(img) {
            img.onerror = null;
            img.style.display = "none";
            var ph = document.createElement("div");
            ph.className = "member-photo-placeholder";
            ph.textContent = img.alt ? img.alt.substring(0,2) : "??";
            img.parentElement.appendChild(ph);
        }
        document.addEventListener('DOMContentLoaded', function() {
            renderMembers();
        });

        function renderMembers() {
            const membersGrid = document.getElementById('members-grid');
            if (!membersGrid || typeof membersData === 'undefined') return;
            
            membersGrid.innerHTML = ''; // Clear for re-render
            
            membersData.forEach((member, index) => {
                const initials = member.name.split(' ').map(n => n[0]).join('').substring(0, 2);
                const photoSrc = (typeof getMemberPhotoSrc === 'function') 
                    ? getMemberPhotoSrc(member) 
                    : member.photo;
                const roleText = (typeof getMemberRoleText === 'function')
                    ? getMemberRoleText(member)
                    : member.role;
                const bioText = (typeof getMemberBioText === 'function')
                    ? getMemberBioText(member)
                    : member.bio;
                    
                const card = document.createElement('div');
                card.className = 'member-card';
                card.setAttribute('data-aos', 'fade-up');
                card.setAttribute('data-aos-delay', (index * 50).toString());
                
                card.innerHTML = `
                    <div class="card-glow"></div>
                    <div class="card-number">${String(index + 1).padStart(2, '0')}</div>
                    <div class="member-photo-wrapper">
                        <img class="member-photo" src="${photoSrc}" 
                             alt="${member.name}" 
                             onerror="handlePhotoError(this)"
                             loading="lazy">
                    </div>
                    <div class="member-role">${roleText}</div>
                    <h3 class="member-name">${member.name}</h3>
                    <p class="member-bio">${bioText}</p>
                    <div class="member-social">
                        <a href="${member.social.instagram}" title="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="${member.social.github}" title="GitHub"><i class="fab fa-github"></i></a>
                    </div>
                `;
                membersGrid.appendChild(card);
            });
            
            // Re-init AOS for new elements
            if (typeof AOS !== 'undefined') {
                AOS.refresh();
            }
        }

        // Listen for admin updates to re-render members
        function handlePhotoError(img) {
            img.onerror = null;
            img.style.display = "none";
            var ph = document.createElement("div");
            ph.className = "member-photo-placeholder";
            ph.textContent = img.alt ? img.alt.substring(0,2) : "??";
            img.parentElement.appendChild(ph);
        }
        document.addEventListener('memberPhotoUpdated', function() {
            renderMembers();
        });

        // ========== SCHEDULE RENDERER ==========
        function handlePhotoError(img) {
            img.onerror = null;
            img.style.display = "none";
            var ph = document.createElement("div");
            ph.className = "member-photo-placeholder";
            ph.textContent = img.alt ? img.alt.substring(0,2) : "??";
            img.parentElement.appendChild(ph);
        }
        document.addEventListener('DOMContentLoaded', function() {
            const scheduleBody = document.getElementById('schedule-body');
            const tabs = document.querySelectorAll('.schedule-tab');
            let activeDay = 'SENIN';

            // Get today's day name
            const todayIdx = new Date().getDay();
            const dayMap = {0: 'MINGGU', 1: 'SENIN', 2: 'SELASA', 3: 'RABU', 4: 'KAMIS', 5: 'JUMAT', 6: 'SABTU'};
            const todayName = dayMap[todayIdx];
            
            if (todayName && todayName !== 'MINGGU' && scheduleData && scheduleData.days[todayName]) {
                activeDay = todayName;
            }

            function renderSchedule(dayName) {
                if (!scheduleBody || !scheduleData || !scheduleData.days[dayName]) return;
                
                const day = scheduleData.days[dayName];
                let html = '';
                
                day.lessons.forEach((item) => {
                    if (item.break) {
                        html += `<tr class="break-row">
                            <td colspan="3"><i class="fas fa-${item.icon || 'coffee'} mr-2"></i>${item.break}</td>
                        </tr>`;
                    } else {
                        html += `<tr>
                            <td class="lesson-number">${item.number}</td>
                            <td class="lesson-icon"><i class="fas ${item.icon || 'fa-book'}"></i></td>
                            <td class="lesson-name">${item.name}</td>
                        </tr>`;
                    }
                });
                
                scheduleBody.innerHTML = html;
            }

            // Set active tab
            function setActiveTab(dayName) {
                tabs.forEach(tab => {
                    tab.classList.toggle('active', tab.dataset.day === dayName);
                });
            }

            // Tab clicks
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    activeDay = tab.dataset.day;
                    setActiveTab(activeDay);
                    renderSchedule(activeDay);
                });
            });

            // Initial render
            setActiveTab(activeDay);
            renderSchedule(activeDay);
        });

        // ========== PRINT SCHEDULE ==========
        function printSchedule() {
            window.print();
        }

        // ========== DOWNLOAD PDF (simple method) ==========
        function downloadSchedulePDF() {
            const scheduleTitle = document.getElementById('schedule-title').textContent;
            const scheduleHTML = document.getElementById('schedule-table').outerHTML;
            const footerHTML = document.querySelector('.schedule-footer').textContent;
            
            const styles = document.querySelector('link[href="assets/css/style.css"]').outerHTML;
            
            const printWindow = window.open('', '_blank');
            printWindow.document.write(`
                <!DOCTYPE html>
                <html>
                <head><title>${scheduleTitle}</title>
                ${styles}
                <style>
                    body { background: #fff; color: #000; padding: 40px; font-family: 'Poppins', sans-serif; }
                    h1 { text-align: center; color: #d97706; margin-bottom: 30px; }
                    table { width: 100%; border-collapse: collapse; }
                    th { background: #f3f4f6; padding: 12px; text-align: left; }
                    td { padding: 10px 12px; border-bottom: 1px solid #e5e7eb; }
                    .break-row td { color: #d97706; font-weight: 600; }
                    .footer { text-align: center; margin-top: 30px; color: #6b7280; }
                </style>
                    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
</head>
                <body>
                    <h1>${scheduleTitle}</h1>
                    ${scheduleHTML}
                    <div class="footer">${footerHTML}</div>
                    <script>
                        window.onload = function() { window.print(); window.close(); }
                    <\/script>
                </body>
                </html>
            `);
            printWindow.document.close();
        }

        // ========== CONTACT FORM ==========
        function handleContactForm(e) {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mengirim...';
            btn.disabled = true;
            
            setTimeout(() => {
                btn.innerHTML = '<i class="fas fa-check-circle"></i> Terkirim!';
                btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
                
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.style.background = '';
                    btn.disabled = false;
                    e.target.reset();
                }, 3000);
            }, 1500);
        }

        // ========== INIT AOS ==========
        function handlePhotoError(img) {
            img.onerror = null;
            img.style.display = "none";
            var ph = document.createElement("div");
            ph.className = "member-photo-placeholder";
            ph.textContent = img.alt ? img.alt.substring(0,2) : "??";
            img.parentElement.appendChild(ph);
        }
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    duration: 800,
                    easing: 'ease-out-cubic',
                    once: true,
                    offset: 100,
                    disable: 'mobile'
                });
            }
        });

        // ========== REGISTER SERVICE WORKER ==========
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('service-worker.js').then(() => {
                    console.log('Service Worker registered');
                }).catch(() => {
                    console.log('Service Worker registration failed');
                });
            });
        }
    </script>
</body>
</html>
