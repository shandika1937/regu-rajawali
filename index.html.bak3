<!DOCTYPE html>
<html lang="id">
<head>
    <!-- ===== META ===== -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="description" content="REGU RAJAWALI 1 - Kelas 8D. Solid • Disiplin • Kompak • Siap Berkarya. Website resmi regu pramuka dan kelas terbaik.">
    <meta name="keywords" content="Regu Rajawali 1, Kelas 8D, Pramuka, Sekolah, Rajawali, Indonesia">
    <meta name="author" content="Regu Rajawali 1">
    <meta name="theme-color" content="#0a1628">
    <meta property="og:title" content="REGU RAJAWALI 1">
    <meta property="og:description" content="Solid • Disiplin • Kompak • Siap Berkarya">
    <meta property="og:type" content="website">
    <meta property="og:image" content="assets/icons/og-image.png">

    <title>REGU RAJAWALI 1 • Kelas 8D</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🦅%3C/text%3E%3C/svg%3E">
    <link rel="apple-touch-icon" href="assets/icons/apple-touch-icon.png">
    <link rel="manifest" href="manifest.json">

    <!-- ===== FONTS ===== -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- ===== FONT AWESOME ===== -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- ===== TAILWIND CSS ===== -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: {} }
        }
    </script>

    <!-- ===== THREE.JS ===== -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <!-- ===== GSAP ===== -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

    <!-- ===== AOS ===== -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <!-- ===== FIREBASE SDK (Realtime Database) ===== -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

    <!-- ===== MAIN CSS ===== -->
    <link rel="stylesheet" href="assets/css/style.css">
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
</head>
<body>

    <!-- ===== CUSTOM CURSOR ===== -->
    <div class="custom-cursor" aria-hidden="true">
        <div class="cursor-dot"></div>
        <div class="cursor-ring"></div>
    </div>

    <!-- ===== MOUSE GLOW ===== -->
    <div class="mouse-glow" aria-hidden="true"></div>

    <!-- ===== THREE.JS BACKGROUND ===== -->
    <canvas id="three-bg"></canvas>

    <!-- ===== PARTICLE CANVAS ===== -->
    <canvas id="particles-canvas"></canvas>

    <!-- ===== LOADING SCREEN ===== -->
    <div id="loading-screen">
        <div class="loading-logo">
            <div class="loading-eagle">
                <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M60 10L75 35L110 20L95 50L110 80L75 65L60 90L45 65L10 80L25 50L10 20L45 35L60 10Z" fill="url(#eagleGrad)" stroke="#00d4ff" stroke-width="1.5"/>
                    <circle cx="60" cy="50" r="8" fill="#0a1628" stroke="#00d4ff" stroke-width="2"/>
                    <path d="M50 55C50 55 55 62 60 62C65 62 70 55 70 55" stroke="#00d4ff" stroke-width="2" fill="none"/>
                    <path d="M55 45L60 40L65 45" stroke="#00d4ff" stroke-width="1.5" fill="none"/>
                    <defs>
                        <linearGradient id="eagleGrad" x1="0" y1="0" x2="120" y2="120">
                            <stop offset="0%" stop-color="#00d4ff"/>
                            <stop offset="100%" stop-color="#7c3aed"/>
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <div class="loading-ring"></div>
            <div class="loading-ring"></div>
        </div>
        <div class="loading-text">REGU RAJAWALI 1</div>
        <div class="loading-progress">
            <div class="loading-progress-bar"></div>
        </div>
    </div>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar" id="navbar">
        <div class="container">
            <a href="#hero" class="navbar-brand">
                <span class="brand-icon">
                    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20 3L28 16L39 11L32 24L39 36L28 29L20 37L12 29L1 36L8 24L1 11L12 16L20 3Z" fill="url(#brandGrad)"/>
                        <defs>
                            <linearGradient id="brandGrad" x1="1" y1="3" x2="39" y2="37">
                                <stop offset="0%" stop-color="#00d4ff"/>
                                <stop offset="100%" stop-color="#7c3aed"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </span>
                <span>Regu Rajawali 1</span>
            </a>

            <ul class="nav-links">
                <li><a href="#hero" class="nav-link active">Home</a></li>
                <li><a href="#members" class="nav-link">Anggota</a></li>
                <li><a href="#schedule" class="nav-link">Jadwal 8D</a></li>
                <li><a href="#chatbot" class="nav-link">AI Bisma</a></li>
                <li><a href="#about" class="nav-link">Tentang</a></li>
                <li><a href="#gallery" class="nav-link">Galeri</a></li>
                <li><a href="#stats" class="nav-link">Statistik</a></li>
                <li><a href="#contact" class="nav-link">Kontak</a></li>
            </ul>

            <button class="navbar-toggle" aria-label="Toggle navigation menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </nav>

    <!-- ===== HERO SECTION ===== -->
    <section class="hero" id="hero">
        <div class="hero-content">
            <div class="hero-badge">
                <i class="fas fa-crown"></i>
                <span>Regu Terbaik Kelas 8D</span>
            </div>

            <h1 class="hero-title">
                <span class="line">REGU</span>
                <span class="line">
                    <span class="gradient-text">RAJAWALI</span>
                    <span class="gold-text"> 1</span>
                </span>
            </h1>

            <p class="hero-subtitle">
                Regu yang menjunjung tinggi kekompakan, disiplin, tanggung jawab, 
                dan semangat belajar. Bersama kita terbang tinggi!
            </p>

            <div class="hero-tagline">
                <span class="tagline-item"><i class="fas fa-check-circle"></i> Solid</span>
                <span class="tagline-item"><i class="fas fa-check-circle"></i> Disiplin</span>
                <span class="tagline-item"><i class="fas fa-check-circle"></i> Kompak</span>
                <span class="tagline-item"><i class="fas fa-check-circle"></i> Siap Berkarya</span>
            </div>

            <div class="hero-actions">
                <a href="#members" class="btn btn-primary btn-shimmer btn-glow">
                    <i class="fas fa-users"></i> Lihat Anggota
                </a>
                <a href="#schedule" class="btn btn-gold btn-shimmer btn-glow">
                    <i class="fas fa-calendar-alt"></i> Jadwal Kelas
                </a>
                <a href="#chatbot" class="btn btn-outline btn-glow" data-confetti>
                    <i class="fas fa-robot"></i> Tanya AI Bisma
                </a>
            </div>

            <div class="scroll-indicator">
                <div class="mouse"></div>
                <span>Scroll</span>
            </div>
        </div>
    </section>

    <!-- ===== MEMBERS SECTION ===== -->
    <section class="section" id="members">
        <div class="container">
            <div class="section-header" data-aos="fade-up" id="member-${m.id}">
                <div class="section-label">
                    <i class="fas fa-users"></i>
                    <span>Anggota Regu</span>
                </div>
                <h2 class="section-title">
                    Kenali <span class="gradient-text">8 Anggota</span> Kami
                </h2>
                <p class="section-description">
                    Setiap anggota memiliki peran dan keunikan masing-masing yang membuat Regu Rajawali 1 semakin solid.
                </p>
            </div>

            <div class="members-grid" id="members-grid">
                <!-- Members will be rendered by JavaScript -->
            </div>
        </div>
    </section>

    <!-- ===== SCHEDULE SECTION ===== -->
    <section class="section" id="schedule">
        <div class="container">
            <div class="section-header" data-aos="fade-up" id="member-${m.id}">
                <div class="section-label">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Jadwal Pelajaran</span>
                </div>
                <h2 class="section-title">
                    Jadwal <span class="gradient-text">Kelas 8D</span>
                </h2>
                <p class="section-description">
                    Tahun Pelajaran 2026/2027 — Lengkap dengan jadwal harian.
                </p>
            </div>

            <div class="schedule-container" data-aos="fade-up" id="member-${m.id}">
                <h3 class="schedule-title" id="schedule-title">JADWAL PELAJARAN VIII 2026/2027</h3>
                
                <div class="schedule-actions">
                    <button class="btn btn-primary btn-sm" onclick="printSchedule()">
                        <i class="fas fa-print"></i> Print
                    </button>
                    <button class="btn btn-gold btn-sm" onclick="downloadSchedulePDF()">
                        <i class="fas fa-file-pdf"></i> Download PDF
                    </button>
                </div>

                <div class="schedule-tabs" id="schedule-tabs">
                    <button class="schedule-tab" data-day="SENIN">Senin</button>
                    <button class="schedule-tab" data-day="SELASA">Selasa</button>
                    <button class="schedule-tab" data-day="RABU">Rabu</button>
                    <button class="schedule-tab" data-day="KAMIS">Kamis</button>
                    <button class="schedule-tab" data-day="JUMAT">Jumat</button>
                    <button class="schedule-tab" data-day="SABTU">Sabtu</button>
                </div>

                <div class="schedule-table-wrapper">
                    <table class="schedule-table" id="schedule-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th></th>
                                <th>Pelajaran</th>
                            </tr>
                        </thead>
                        <tbody id="schedule-body">
                            <!-- Rendered by JS -->
                        </tbody>
                    </table>
                </div>

                <div class="schedule-footer">
                    TDD: Sule Anderson M.bg S.mp S.d
                </div>
            </div>
        </div>
    </section>

    <!-- ===== AI BISMA CHATBOT SECTION ===== -->
    <section class="section" id="chatbot">
        <div class="container">
            <div class="section-header" data-aos="fade-up" id="member-${m.id}">
                <div class="section-label">
                    <i class="fas fa-robot"></i>
                    <span>AI Assistant</span>
                </div>
                <h2 class="section-title">
                    Tanya <span class="gradient-text">AI Bisma</span>
                </h2>
                <p class="section-description">
                    Asisten virtual pintar yang siap menjawab pertanyaan seputar jadwal pelajaran kelas 8D secara offline!
                </p>
            </div>

            <div class="chatbot-container" data-aos="fade-up" id="member-${m.id}" data-aos-delay="100">
                <div class="chatbot-card">
                    <div class="chatbot-header">
                        <div class="chatbot-info">
                            <div class="chatbot-avatar">
                                <i class="fas fa-robot"></i>
                            </div>
                            <div>
                                <div class="chatbot-name">AI Bisma</div>
                                <div class="chatbot-status">
                                    <span class="dot"></span>
                                    Online
                                </div>
                            </div>
                        </div>
                        <div class="chatbot-actions">
                            <button id="tts-btn" title="Text to Speech">
                                <i class="fas fa-volume-up"></i>
                            </button>
                            <button id="chat-theme" title="Toggle Theme">
                                <i class="fas fa-palette"></i>
                            </button>
                            <button id="chat-clear" title="Clear Chat">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    </div>

                    <div class="chatbot-body" id="chatbot-body">
                        <div class="chatbot-messages" id="chat-messages">
                            <!-- Messages rendered by JS -->
                        </div>
                    </div>

                    <div class="chatbot-input-area">
                        <input type="text" class="chatbot-input" id="chat-input" 
                               placeholder="Tanya tentang jadwal pelajaran..." autocomplete="off">
                        <button class="voice-btn" id="voice-btn" title="Voice Input">
                            <i class="fas fa-microphone"></i>
                        </button>
                        <button class="chatbot-send" id="chat-send">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== ABOUT SECTION ===== -->
    <section class="section" id="about">
        <div class="container">
            <div class="section-header" data-aos="fade-up" id="member-${m.id}">
                <div class="section-label">
                    <i class="fas fa-info-circle"></i>
                    <span>Tentang Regu</span>
                </div>
                <h2 class="section-title">
                    Cerita <span class="gradient-text">Regu Rajawali 1</span>
                </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center" data-aos="fade-up" id="member-${m.id}">
                <div>
                    <h3 class="text-xl font-semibold mb-4" style="color: var(--neon-blue);">
                        <i class="fas fa-quote-left mr-2" style="color: var(--neon-gold);"></i>
                        Solid • Disiplin • Kompak • Siap Berkarya
                    </h3>
                    <p class="mb-4" style="color: var(--text-secondary); line-height: 1.8;">
                        Regu Rajawali 1 adalah regu pramuka dari Kelas 8D yang berdiri dengan semangat kebersamaan 
                        dan dedikasi tinggi. Kami percaya bahwa dengan kekompakan dan disiplin, segala tantangan 
                        bisa dihadapi bersama.
                    </p>
                    <p class="mb-4" style="color: var(--text-secondary); line-height: 1.8;">
                        Setiap anggota regu memiliki peran penting dalam menjaga harmoni dan mencapai tujuan bersama. 
                        Dari ketua regu hingga anggota, semua saling mendukung dan bekerja sama.
                    </p>
                    <div class="flex flex-wrap gap-4 mt-6">
                        <div class="flex items-center gap-3 p-4 rounded-xl" style="background: var(--gradient-card); border: 1px solid var(--glass-border);">
                            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(0,212,255,0.12); color: var(--neon-blue);">
                                <i class="fas fa-users"></i>
                            </div>
                            <div>
                                <div class="font-semibold">8 Anggota</div>
                                <div class="text-sm" style="color: var(--text-muted);">Solid dan kompak</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-4 rounded-xl" style="background: var(--gradient-card); border: 1px solid var(--glass-border);">
                            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(255,215,0,0.12); color: var(--neon-gold);">
                                <i class="fas fa-star"></i>
                            </div>
                            <div>
                                <div class="font-semibold">Kelas 8D</div>
                                <div class="text-sm" style="color: var(--text-muted);">Penuh prestasi</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="relative">
                    <div class="rounded-2xl overflow-hidden" style="background: var(--gradient-card); border: 1px solid var(--glass-border); aspect-ratio: 4/3;">
                        <div class="w-full h-full flex items-center justify-center">
                            <svg viewBox="0 0 200 200" class="w-48 h-48" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <linearGradient id="eagleGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#00d4ff"/>
                                        <stop offset="100%" stop-color="#7c3aed"/>
                                    </linearGradient>
                                </defs>
                                <path d="M100 20L120 55L160 35L140 75L165 115L120 100L100 140L80 100L35 115L60 75L40 35L80 55L100 20Z" fill="url(#eagleGrad2)" opacity="0.8"/>
                                <circle cx="100" cy="80" r="15" fill="#0a1628" stroke="#00d4ff" stroke-width="3"/>
                                <path d="M85 90C85 90 92 100 100 100C108 100 115 90 115 90" stroke="#00d4ff" stroke-width="3" fill="none"/>
                                <path d="M93 75L100 67L107 75" stroke="#ffd700" stroke-width="2.5" fill="none"/>
                            </svg>
                        </div>
                    </div>
                    <div class="absolute -bottom-4 -right-4 w-32 h-32 rounded-full opacity-20" style="background: radial-gradient(circle, var(--neon-blue), transparent);"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== GALLERY SECTION ===== -->
    <section class="section" id="gallery">
        <div class="container">
            <div class="section-header" data-aos="fade-up" id="member-${m.id}">
                <div class="section-label">
                    <i class="fas fa-images"></i>
                    <span>Galeri</span>
                </div>
                <h2 class="section-title">
                    Momen <span class="gradient-text">Kebersamaan</span>
                </h2>
                <p class="section-description">
                    Dokumentasi kegiatan dan momen berharga Regu Rajawali 1.
                </p>
            </div>

            <div class="gallery-grid" id="gallery-grid" data-aos="fade-up" id="member-${m.id}">
                <!-- Gallery items rendered by JS -->
            </div>

            <div class="text-center mt-8">
                <button class="btn btn-outline" id="gallery-load-more">
                    <i class="fas fa-plus"></i> Load More
                </button>
            </div>
        </div>
    </section>

    <!-- ===== LIGHTBOX ===== -->
    <div class="lightbox" id="lightbox">
        <button class="lightbox-close" id="lightbox-close">
            <i class="fas fa-times"></i>
        </button>
        <button class="lightbox-nav prev" id="lightbox-prev">
            <i class="fas fa-chevron-left"></i>
        </button>
        <img id="lightbox-img" src="" alt="Gallery Image">
        <button class="lightbox-nav next" id="lightbox-next">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>

    <!-- ===== STATS SECTION ===== -->
    <section class="section" id="stats">
        <div class="container">
            <div class="section-header" data-aos="fade-up" id="member-${m.id}">
                <div class="section-label">
                    <i class="fas fa-chart-bar"></i>
                    <span>Statistik</span>
                </div>
                <h2 class="section-title">
                    Real-time <span class="gradient-text">Statistik</span>
                </h2>
                <p class="section-description">
                    Data real-time pengunjung dan aktivitas website Regu Rajawali 1.
                </p>
            </div>

            <div class="stats-container" data-aos="fade-up" id="member-${m.id}">
                <div class="stat-card float-anim">
                    <div class="stat-icon blue">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="stat-number" id="stat-visitors">0</div>
                    <div class="stat-label">Total Pengunjung</div>
                </div>
                <div class="stat-card float-anim" style="animation-delay: 0.2s;">
                    <div class="stat-icon gold">
                        <i class="fas fa-wifi"></i>
                    </div>
                    <div class="stat-number" id="stat-online">0</div>
                    <div class="stat-label">Online Sekarang</div>
                </div>
                <div class="stat-card float-anim" style="animation-delay: 0.4s;">
                    <div class="stat-icon purple">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="stat-number" id="stat-days">0</div>
                    <div class="stat-label">Hari Aktif</div>
                </div>
                <div class="stat-card float-anim" style="animation-delay: 0.6s;">
                    <div class="stat-icon green">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-number" id="stat-online-time">00:00:00</div>
                    <div class="stat-label">Waktu Online</div>
                </div>
            </div>

            <div class="clock-container" data-aos="fade-up" id="member-${m.id}" data-aos-delay="100">
                <div class="clock-time" id="clock-time">--:--:--</div>
                <div class="clock-date" id="clock-date">Loading...</div>
            </div>
        </div>
    </section>

    <!-- ===== CONTACT SECTION ===== -->
    <section class="section" id="contact">
        <div class="container">
            <div class="section-header" data-aos="fade-up" id="member-${m.id}">
                <div class="section-label">
                    <i class="fas fa-envelope"></i>
                    <span>Kontak</span>
                </div>
                <h2 class="section-title">
                    Hubungi <span class="gradient-text">Kami</span>
                </h2>
                <p class="section-description">
                    Punya pertanyaan atau ingin berkolaborasi? Jangan ragu untuk menghubungi kami!
                </p>
            </div>

            <div class="contact-container" data-aos="fade-up" id="member-${m.id}">
                <div class="contact-info">
                    <div class="contact-item">
                        <div class="icon blue"><i class="fas fa-map-marker-alt"></i></div>
                        <div class="text">
                            <h4>Lokasi</h4>
                            <p>SMP Negeri 8 - Kelas 8D</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="icon gold"><i class="fas fa-envelope"></i></div>
                        <div class="text">
                            <h4>Email</h4>
                            <p>rajawali1.8d@gmail.com</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="icon purple"><i class="fas fa-instagram"></i></div>
                        <div class="text">
                            <h4>Instagram</h4>
                            <p>@rajawali1_8d</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="icon blue"><i class="fas fa-phone-alt"></i></div>
                        <div class="text">
                            <h4>Telepon</h4>
                            <p>+62 8XX-XXXX-XXXX</p>
                        </div>
                    </div>
                </div>

                <form class="contact-form" id="contact-form" onsubmit="handleContactForm(event)">
                    <div class="form-group">
                        <label for="contact-name">Nama Lengkap</label>
                        <input type="text" id="contact-name" placeholder="Masukkan nama Anda..." required>
                    </div>
                    <div class="form-group">
                        <label for="contact-email">Email</label>
                        <input type="email" id="contact-email" placeholder="contoh@email.com" required>
                    </div>
                    <div class="form-group">
                        <label for="contact-subject">Subjek</label>
                        <input type="text" id="contact-subject" placeholder="Subjek pesan...">
                    </div>
                    <div class="form-group">
                        <label for="contact-message">Pesan</label>
                        <textarea id="contact-message" placeholder="Tulis pesan Anda di sini..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-full justify-center">
                        <i class="fas fa-paper-plane"></i> Kirim Pesan
                    </button>
                </form>
            </div>
        </div>
    </section>

